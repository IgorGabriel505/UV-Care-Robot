<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- ===================================================== -->
    <!-- CONTEÚDO PRINCIPAL                                    -->
    <!-- ===================================================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#F4F7FB">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- ================================================= -->
            <!-- BARRA SUPERIOR                                    -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:background="#FFFFFF">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:src="@drawable/ic_menu"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="10dp"
                    android:contentDescription="Abrir menu" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="UV-Care Robot"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#142033" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CONTEÚDO                                         -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">


                <!-- TÍTULO -->

                <TextView
                    android:id="@+id/subtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:text="Painel de Controle"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#142033"
                    android:letterSpacing="0.01" />


                <!-- ================================================= -->
                <!-- QUADRO DO ROBÔ                                    -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:background="#FFFFFF"
                    android:padding="20dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Robô UV-01"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#142033" />


                    <ImageView
                        android:id="@+id/imagemRobo"
                        android:layout_width="140dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="6dp"
                        android:src="@drawable/robo_uv_care_"
                        android:scaleType="fitCenter"
                        android:contentDescription="Imagem do robô UV-01" />


                    <TextView
                        android:id="@+id/textConexao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_conexao"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="● Robô conectado"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />


                    <!-- STATUS -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F4F7FB"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status:"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#142033" />

                        <TextView
                            android:id="@+id/textStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Em espera"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#6B778C" />

                    </LinearLayout>


                    <!-- BATERIA -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F4F7FB"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bateria:"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#142033" />

                        <TextView
                            android:id="@+id/textBateria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="--%"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#6B778C" />

                    </LinearLayout>


                    <!-- LOCAL -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F4F7FB"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Local atual:"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#142033" />

                        <TextView
                            android:id="@+id/textLocal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Ala A · Leito 01"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#6B778C" />

                    </LinearLayout>


                    <!-- UV-C -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="#F4F7FB"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="UV-C:"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#142033" />

                        <TextView
                            android:id="@+id/textUvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Desligada"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#6B778C" />

                    </LinearLayout>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- SEGURANÇA UV-C                                    -->
                <!-- ================================================= -->

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="#FFF9C4"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="⚠ Segurança UV-C"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#F57F17" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.1"
                            android:text="A emissão ultravioleta só deve ocorrer em ambiente isolado, sem pacientes ou profissionais expostos. O protótipo considera sensores de presença, trava de porta e confirmação antes da desinfecção."
                            android:textSize="13sp"
                            android:textColor="#5D4037" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!-- ================================================= -->
                <!-- BOTÃO LIGAR                                      -->
                <!-- ================================================= -->

                <Button
                    android:id="@+id/btnPower"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:text="Ligar robô"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2196F3" />


                <!-- ================================================= -->
                <!-- PARADA SEGURA                                    -->
                <!-- ================================================= -->

                <Button
                    android:id="@+id/btnParadaSegura"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="10dp"
                    android:text="Parada segura"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D32F2F" />


                <!-- ================================================= -->
                <!-- RETORNAR À BASE                                   -->
                <!-- ================================================= -->

                <Button
                    android:id="@+id/btnRetornarBase"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="10dp"
                    android:text="Retornar à base"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#6C4CCF" />


                <!-- ================================================= -->
                <!-- CONTROLES DE SEGURANÇA                            -->
                <!-- ================================================= -->

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="22dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">


                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Controles de segurança"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#142033" />


                        <!-- PRIMEIRA LINHA -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">


                            <!-- SENSOR DE PRESENÇA -->

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="110dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#FFFFFF">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center_vertical"
                                    android:padding="16dp"
                                    android:background="@drawable/bg_quadro_seguranca">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Sensor de presença"
                                        android:textSize="13sp"
                                        android:textColor="#6B778C" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Ativo"
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:textColor="#142033" />

                                </LinearLayout>

                            </androidx.cardview.widget.CardView>


                            <!-- TRAVA DE PORTA -->

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="110dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#FFFFFF">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center_vertical"
                                    android:padding="16dp"
                                    android:background="@drawable/bg_quadro_seguranca">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Trava de porta"
                                        android:textSize="13sp"
                                        android:textColor="#6B778C" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Ativa"
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:textColor="#142033" />

                                </LinearLayout>

                            </androidx.cardview.widget.CardView>

                        </LinearLayout>


                        <!-- SEGUNDA LINHA -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">


                            <!-- MAPA HOSPITALAR -->

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="110dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#FFFFFF">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center_vertical"
                                    android:padding="16dp"
                                    android:background="@drawable/bg_quadro_seguranca">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Mapa hospitalar"
                                        android:textSize="13sp"
                                        android:textColor="#6B778C" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Carregado"
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:textColor="#142033" />

                                </LinearLayout>

                            </androidx.cardview.widget.CardView>


                            <!-- RETORNO À BASE -->

                            <androidx.cardview.widget.CardView
                                android:layout_width="0dp"
                                android:layout_height="110dp"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#FFFFFF">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:gravity="center_vertical"
                                    android:padding="16dp"
                                    android:background="@drawable/bg_quadro_seguranca">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="Retorno à base"
                                        android:textSize="13sp"
                                        android:textColor="#6B778C" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:text="Automático"
                                        android:textSize="20sp"
                                        android:textStyle="bold"
                                        android:textColor="#142033" />

                                </LinearLayout>

                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="30dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- MENU LATERAL                                          -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/menuLateral"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true">


        <!-- CABEÇALHO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="24dp"
            android:background="#142033">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UV-Care Robot"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Sistema de desinfecção autônoma"
                android:textSize="13sp"
                android:textColor="#B8C4D6" />

        </LinearLayout>


        <!-- PAINEL -->

        <TextView
            android:id="@+id/menuPainel"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:text="🏠   Painel de Controle"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#142033"
            android:background="#EAF2FF"
            android:clickable="true"
            android:focusable="true" />


        <!-- MISSÕES -->

        <TextView
            android:id="@+id/menuMissoes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:text="🎯   Missões"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#142033"
            android:clickable="true"
            android:focusable="true" />


        <!-- CONFIGURAÇÕES -->

        <TextView
            android:id="@+id/menuConfiguracoes"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="16dp"
            android:text="⚙   Configurações"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#142033"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>